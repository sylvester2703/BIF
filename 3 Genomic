import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import (
    accuracy_score, classification_report,
    confusion_matrix, ConfusionMatrixDisplay
)

# 1. Generate sample genomic data
np.random.seed(42)

X = np.random.randint(0, 3, size=(300, 20))
y = ((X[:, 0] + X[:, 1] + X[:, 2]) >= 3).astype(int)

features = [f"Marker_{i+1}" for i in range(20)]
df = pd.DataFrame(X, columns=features)
df["Class"] = y

print("Dataset preview:")
print(df.head())

# 2. Split data
X_train, X_test, y_train, y_test = train_test_split(
    df[features], y, test_size=0.2,
    random_state=42, stratify=y
)

# 3. Train Random Forest
model = RandomForestClassifier(
    n_estimators=100, random_state=42
)
model.fit(X_train, y_train)

# 4. Predictions and evaluation
pred = model.predict(X_test)

accuracy = accuracy_score(y_test, pred)
print("\nAccuracy:", round(accuracy * 100, 2), "%")
print("\nClassification Report:\n",
      classification_report(y_test, pred, zero_division=0))

ConfusionMatrixDisplay(
    confusion_matrix(y_test, pred)
).plot()
plt.title("Genomic Classification")
plt.show()

# 5. Feature importance
importance = pd.Series(
    model.feature_importances_, index=features
).sort_values(ascending=False)

print("\nTop Predictive Markers:")
print(importance.head(10))

importance.head(10).sort_values().plot(kind="barh")
plt.xlabel("Feature Importance")
plt.title("Top Genomic Markers")
plt.tight_layout()
plt.show()

# 6. Save report
df.to_csv("Genomic_Dataset.csv", index=False)
importance.to_csv("Genomic_Feature_Importance.csv")

with open("Genomic_Analysis_Report.txt", "w") as f:
    f.write("MACHINE LEARNING FOR GENOMIC DATA\n\n")
    f.write(f"Samples: {len(df)}\n")
    f.write(f"Genetic markers: {len(features)}\n")
    f.write(f"Accuracy: {accuracy:.4f}\n\n")
    f.write(classification_report(y_test, pred, zero_division=0))
    f.write("\n\nFeature Importance:\n")
    f.write(importance.to_string())

print("\nDataset, feature importance and report saved.")

