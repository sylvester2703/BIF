import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split, cross_val_score
from sklearn.ensemble import RandomForestClassifier
from sklearn.svm import SVC
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import *
from sklearn.inspection import permutation_importance
# 1. Generate a synthetic genomic dataset
np.random.seed(42)
n_samples, n_markers = 500, 25
markers = [f"Marker_{i+1}" for i in range(n_markers)]
X = np.random.binomial(2, 0.3, (n_samples, n_markers))
risk = 1.5*X[:, 0] + 1.2*X[:, 1] + X[:, 2] + 0.8*X[:, 3] + np.random.normal(0, 1.5, n_samples)
y = (risk > np.median(risk)).astype(int)
df = pd.DataFrame(X, columns=markers)
df["Class"] = y
df.to_csv("Genomic_Dataset.csv", index=False)
# 2. Split the data
X_train, X_test, y_train, y_test = train_test_split(
    df[markers], y, test_size=0.2, random_state=42, stratify=y
)
# 3. Define classification models
models = {
    "Random Forest": RandomForestClassifier(
        n_estimators=200, class_weight="balanced", random_state=42
    ),
    "SVM": make_pipeline(
        StandardScaler(),
        SVC(kernel="rbf", probability=True, class_weight="balanced", random_state=42)
    )
}
# 4. Train and evaluate both models
results, predictions, probabilities, cv_results = {}, {}, {}, {}
for name, model in models.items():
    model.fit(X_train, y_train)
    pred = model.predict(X_test)
    prob = model.predict_proba(X_test)[:, 1]
    predictions[name], probabilities[name] = pred, prob
    results[name] = {
        "Accuracy": accuracy_score(y_test, pred),
        "Precision": precision_score(y_test, pred, zero_division=0),
        "Recall": recall_score(y_test, pred, zero_division=0),
        "F1 Score": f1_score(y_test, pred, zero_division=0),
        "ROC AUC": roc_auc_score(y_test, prob)
    }
    cv_results[name] = cross_val_score(
        model, X_train, y_train, cv=5, scoring="accuracy"
    )
performance = pd.DataFrame(results).T
performance.to_csv("Model_Performance.csv")
print("\nMODEL PERFORMANCE\n", performance.round(4))
for name in models:
    print(f"\n{name} Classification Report\n",
          classification_report(y_test, predictions[name], zero_division=0))
    print(f"5-fold CV accuracy: {cv_results[name].mean():.4f} "
          f"+/- {cv_results[name].std():.4f}")
# 5. Plot confusion matrices
fig, axes = plt.subplots(1, 2, figsize=(10, 4))
for ax, name in zip(axes, models):
    ConfusionMatrixDisplay.from_predictions(
        y_test, predictions[name], ax=ax, colorbar=False
    )
    ax.set_title(name)
plt.tight_layout()
plt.savefig("Genomic_Confusion_Matrices.png", dpi=300)
plt.show()
# 6. Plot ROC curves
plt.figure(figsize=(7, 5))
for name in models:
    RocCurveDisplay.from_predictions(
        y_test, probabilities[name], name=name
    )
plt.plot([0, 1], [0, 1], "--")
plt.title("ROC Curve Comparison")
plt.tight_layout()
plt.savefig("Genomic_ROC_Curve.png", dpi=300)
plt.show()
# 7. Identify important genomic markers
importance = pd.Series(
    models["Random Forest"].feature_importances_, index=markers
).sort_values(ascending=False)
importance.to_csv("Random_Forest_Feature_Importance.csv")
permutation = pd.DataFrame({
    name: permutation_importance(
        model, X_test, y_test, n_repeats=10,
        random_state=42, scoring="accuracy"
    ).importances_mean
    for name, model in models.items()
}, index=markers)
permutation.to_csv("Permutation_Feature_Importance.csv")
importance.head(10).sort_values().plot(kind="barh", figsize=(8, 5))
plt.xlabel("Importance")
plt.title("Top Predictive Genomic Markers - Random Forest")
plt.tight_layout()
plt.savefig("Genomic_Feature_Importance.png", dpi=300)
plt.show()
# 8. Generate the analysis report
best = performance["F1 Score"].idxmax()
with open("Genomic_Analysis_Report.txt", "w", encoding="utf-8") as f:
    f.write("MACHINE LEARNING FOR GENOMIC DATA\n")
    f.write("=" * 40 + "\n\n")
    f.write(f"Samples: {n_samples}\nMarkers: {n_markers}\n")
    f.write("Dataset: Synthetic demonstration data\n")
    f.write("Target: Simulated binary class\n\n")
    f.write("METHOD: 80/20 stratified split; Random Forest and SVM; "
            "five-fold cross-validation.\n\n")
    f.write("MODEL PERFORMANCE\n" + performance.round(4).to_string())
    f.write("\n\nCROSS-VALIDATION\n")
    for name, scores in cv_results.items():
        f.write(f"{name}: mean={scores.mean():.4f}, SD={scores.std():.4f}\n")
    f.write("\nCLASSIFICATION REPORTS\n")
    for name in models:
        f.write(f"\n{name}\n")
        f.write(classification_report(
            y_test, predictions[name], zero_division=0
        ))
    f.write("\nTOP PREDICTIVE MARKERS\n" + importance.head(10).to_string())
    f.write("\n\nBIOLOGICAL INTERPRETATION\n")
    f.write("Feature importance indicates which markers contribute to "
            "model predictions. Permutation importance measures the "
            "effect of shuffling each marker on predictive accuracy.\n")
    f.write("The labels were generated using selected markers. Results "
            "are synthetic and do not establish real genetic associations "
            "or biological causation. Real biological interpretation "
            "requires marker annotation and independent validation.\n")
    f.write(f"\nCONCLUSION\nBest model by test F1 score: {best}\n")
    f.write("Compare accuracy, precision, recall, F1, ROC AUC and "
            "cross-validation before selecting a model.\n")
print("\nAnalysis completed successfully.")
print("Generated files:")
for file in [
    "Genomic_Dataset.csv", "Model_Performance.csv",
    "Random_Forest_Feature_Importance.csv",
    "Permutation_Feature_Importance.csv",
    "Genomic_Confusion_Matrices.png", "Genomic_ROC_Curve.png",
    "Genomic_Feature_Importance.png", "Genomic_Analysis_Report.txt"
]:
    print(file)
