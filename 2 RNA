        if not upregulated.empty else "None identified."
    )

    report.write("\n\nDOWNREGULATED GENES\n")
    report.write(
        downregulated.to_string(index=False)
        if not downregulated.empty else "None identified."
    )

    report.write("\n\nBIOLOGICAL INTERPRETATION\n")
    report.write(
        f"Positive log2 fold changes indicate higher expression "
        f"in {treatment} relative to {reference}. Negative values "
