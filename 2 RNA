# RNA-Seq Differential Gene Expression Analysis
# General Code - External Dataset
# Compatible with PyDESeq2 0.5.4

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from pydeseq2.dds import DeseqDataSet
from pydeseq2.ds import DeseqStats

# --------------------------------------------------
# 1. LOAD DATA
# --------------------------------------------------

counts = pd.read_csv("rnaseq_counts.csv", index_col=0)
metadata = pd.read_csv("sample_metadata.csv")

counts.index = counts.index.astype(str)
counts.columns = counts.columns.astype(str)

if not counts.index.is_unique:
    raise ValueError("Gene IDs in the count matrix must be unique.")

if not counts.columns.is_unique:
    raise ValueError("Sample names in the count matrix must be unique.")

if not {"sample", "condition"}.issubset(metadata.columns):
    raise ValueError(
        "Metadata must contain 'sample' and 'condition' columns."
    )

metadata["sample"] = metadata["sample"].astype(str)
metadata["condition"] = metadata["condition"].astype(str)

if metadata["sample"].duplicated().any():
    raise ValueError("Sample names in metadata must be unique.")

metadata = metadata.set_index("sample")

if set(counts.columns) != set(metadata.index):
    raise ValueError(
        "Sample names in counts and metadata must match exactly."
    )

# --------------------------------------------------
# 2. VALIDATE AND ALIGN DATA
# --------------------------------------------------

metadata = metadata.loc[counts.columns]

if metadata["condition"].isna().any():
    raise ValueError("Condition labels cannot be missing.")

if metadata["condition"].nunique() != 2:
    raise ValueError("Exactly two conditions are required.")

values = counts.to_numpy(dtype=float)

if not np.isfinite(values).all():
    raise ValueError("Count matrix contains missing or infinite values.")

if (values < 0).any():
    raise ValueError("Counts cannot be negative.")

if not np.allclose(values, np.round(values)):
    raise ValueError("Use raw integer read counts, not TPM or FPKM.")

counts = counts.astype(int)

# PyDESeq2 0.5.4 expects:
# Rows = samples
# Columns = genes
count_df = counts.T.copy()

# Ensure metadata follows the same sample order
metadata = metadata.loc[count_df.index]

assert count_df.index.equals(metadata.index)

# At least 2 replicates per group are needed computationally;
# 3 or more biological replicates per group are recommended.
group_sizes = metadata["condition"].value_counts()

if (group_sizes < 2).any():
    raise ValueError("Each condition needs at least 2 samples.")

print("Count matrix (samples x genes):", count_df.shape)
print("\nSample distribution:")
print(group_sizes)

# --------------------------------------------------
# 3. FILTER LOW-COUNT GENES
# --------------------------------------------------

count_df = count_df.loc[:, count_df.sum(axis=0) >= 10]

if count_df.shape[1] == 0:
    raise ValueError("No genes remain after low-count filtering.")

print("\nGenes retained:", count_df.shape[1])

# --------------------------------------------------
# 4. SET REFERENCE AND TREATMENT CONDITIONS
# --------------------------------------------------

conditions = metadata["condition"].unique()

# Prefer Control as reference when present
if "Control" in conditions:
    reference = "Control"
    treatment = next(c for c in conditions if c != reference)
else:
    reference, treatment = conditions[0], conditions[1]

metadata["condition"] = pd.Categorical(
    metadata["condition"],
    categories=[reference, treatment]
)

# --------------------------------------------------
# 5. DIFFERENTIAL EXPRESSION ANALYSIS
# --------------------------------------------------

dds = DeseqDataSet(
    counts=count_df,
    metadata=metadata,
    design="~condition",
    refit_cooks=True,
    n_cpus=1
)

dds.deseq2()

stats = DeseqStats(
    dds,
    contrast=("condition", treatment, reference),
    n_cpus=1
)

stats.summary()

results = stats.results_df.copy()
results.index.name = "gene_id"

# --------------------------------------------------
# 6. CLASSIFY DIFFERENTIALLY EXPRESSED GENES
# --------------------------------------------------

results["Status"] = "Not Significant"

significant = (
    results["padj"].notna()
    & (results["padj"] < 0.05)
    & (results["log2FoldChange"].abs() >= 1)
)

results.loc[
    significant & (results["log2FoldChange"] > 0),
    "Status"
] = "Upregulated"

results.loc[
    significant & (results["log2FoldChange"] < 0),
    "Status"
] = "Downregulated"

# --------------------------------------------------
# 7. ADD FUNCTIONAL ANNOTATIONS IF AVAILABLE
# --------------------------------------------------

results = results.reset_index()

try:
    annotation = pd.read_csv("gene_annotation.csv")

    required = {"gene_id", "gene_name", "description"}

    if not required.issubset(annotation.columns):
        raise ValueError(
            "Annotation file must contain gene_id, gene_name, "
            "and description columns."
        )

    annotation["gene_id"] = annotation["gene_id"].astype(str)

    if annotation["gene_id"].duplicated().any():
        raise ValueError(
            "Annotation file contains duplicate gene IDs."
        )

    results = results.merge(
        annotation,
        on="gene_id",
        how="left",
        validate="one_to_one"
    )

    print("\nFunctional annotation file loaded.")

except FileNotFoundError:
    results["gene_name"] = results["gene_id"]
    results["description"] = "Annotation not provided"
    print("\nNo annotation file found; reporting gene IDs only.")

results = results.sort_values("padj", na_position="last")

upregulated = results[results["Status"] == "Upregulated"]
downregulated = results[results["Status"] == "Downregulated"]

differential = results[
    results["Status"].isin(["Upregulated", "Downregulated"])
]

# --------------------------------------------------
# 8. DISPLAY RESULTS
# --------------------------------------------------

print("\n--- DIFFERENTIAL EXPRESSION SUMMARY ---")
print("Reference:", reference)
print("Treatment:", treatment)
print("Genes analyzed:", len(results))
print("Upregulated genes:", len(upregulated))
print("Downregulated genes:", len(downregulated))
print("Significant genes:", len(differential))

print("\nTop significant genes:")
print(differential.head(10).to_string(index=False))

# --------------------------------------------------
# 9. SAVE RESULTS
# --------------------------------------------------

results.to_csv("RNASeq_Differential_Expression.csv", index=False)
upregulated.to_csv("Upregulated_Genes.csv", index=False)
downregulated.to_csv("Downregulated_Genes.csv", index=False)

# --------------------------------------------------
# 10. GENERATE VOLCANO PLOT
# --------------------------------------------------

plot_df = results.dropna(
    subset=["log2FoldChange", "padj"]
).copy()

plot_df["neg_log10_padj"] = -np.log10(
    plot_df["padj"].clip(lower=1e-300)
)

plt.figure(figsize=(9, 6))

for status in [
    "Not Significant", "Upregulated", "Downregulated"
]:
    subset = plot_df[plot_df["Status"] == status]

    plt.scatter(
        subset["log2FoldChange"],
        subset["neg_log10_padj"],
        label=status,
        alpha=0.7,
        s=20
    )

plt.axvline(1, linestyle="--")
plt.axvline(-1, linestyle="--")
plt.axhline(-np.log10(0.05), linestyle="--")

plt.xlabel("Log2 Fold Change")
plt.ylabel("-Log10 Adjusted P-value")
plt.title("RNA-Seq Differential Gene Expression")
plt.legend()
plt.tight_layout()
plt.savefig("RNASeq_Volcano_Plot.png", dpi=300)
plt.show()

# --------------------------------------------------
# 11. GENERATE DETAILED REPORT
# --------------------------------------------------

with open("RNASeq_Analysis_Report.txt", "w", encoding="utf-8") as report:

    report.write("RNA-SEQ DIFFERENTIAL EXPRESSION REPORT\n")
    report.write("=" * 45 + "\n\n")

    report.write(f"Reference condition: {reference}\n")
    report.write(f"Treatment condition: {treatment}\n")
    report.write(f"Samples analyzed: {len(metadata)}\n")
    report.write(f"Genes analyzed: {len(results)}\n")
    report.write(f"Upregulated genes: {len(upregulated)}\n")
