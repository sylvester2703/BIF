"""
# RNA-Seq Analysis - Small Code

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.stats import ttest_ind
from statsmodels.stats.multitest import multipletests

# Load raw gene counts
df = pd.read_csv("rnaseq_counts.csv", index_col=0)

# Validate input
if df.shape[1] < 6:
    raise ValueError("Provide at least 3 control and 3 treatment samples.")

if not df.index.is_unique:
    raise ValueError("Gene IDs must be unique.")

if df.isna().any().any() or (df < 0).any().any():
    raise ValueError("Counts must be non-negative and contain no missing values.")

if not np.isfinite(df.to_numpy(dtype=float)).all():
    raise ValueError("Counts contain infinite or invalid values.")

if not np.allclose(df.to_numpy(dtype=float),
                   np.round(df.to_numpy(dtype=float))):
    raise ValueError("Use raw integer read counts.")

df = df.astype(int)
df = df.loc[df.sum(axis=1) >= 10]

control = df.iloc[:, :3]
treatment = df.iloc[:, 3:6]

# Calculate fold changes and Welch's t-tests
log2fc = (
    np.log2(treatment.mean(axis=1) + 1)
    - np.log2(control.mean(axis=1) + 1)
)

pvalues = [
    ttest_ind(
        np.log2(treatment.loc[g] + 1),
        np.log2(control.loc[g] + 1),
        equal_var=False
    ).pvalue
    for g in df.index
]

# Correct p-values for multiple testing
padj = multipletests(pvalues, method="fdr_bh")[1]

results = pd.DataFrame({
    "Control_Mean": control.mean(axis=1),
    "Treatment_Mean": treatment.mean(axis=1),
    "Log2_Fold_Change": log2fc,
    "P_Value": pvalues,
    "Adjusted_P_Value": padj
}, index=df.index)

results["Status"] = "Not Significant"

sig = (
    (results["Adjusted_P_Value"] < 0.05)
    & (results["Log2_Fold_Change"].abs() >= 1)
)

results.loc[
    sig & (results["Log2_Fold_Change"] > 0), "Status"
] = "Upregulated"

results.loc[
    sig & (results["Log2_Fold_Change"] < 0), "Status"
] = "Downregulated"

results.sort_values("Adjusted_P_Value").to_csv(
    "Differential_Expression_Results.csv"
)

print(results.sort_values("Adjusted_P_Value").head(10))
print("\nUpregulated:", (results["Status"] == "Upregulated").sum())
print("Downregulated:", (results["Status"] == "Downregulated").sum())

# Volcano plot
plot = results.dropna(subset=["Adjusted_P_Value"]).copy()
plot["neg_log10_padj"] = -np.log10(
    plot["Adjusted_P_Value"].clip(lower=1e-300)
)

plt.figure(figsize=(8, 5))
plt.scatter(plot["Log2_Fold_Change"], plot["neg_log10_padj"])
plt.axvline(1, linestyle="--")
plt.axvline(-1, linestyle="--")
plt.axhline(-np.log10(0.05), linestyle="--")
plt.xlabel("Log2 Fold Change")
plt.ylabel("-Log10 Adjusted P-value")
plt.title("RNA-Seq Differential Expression")
plt.tight_layout()
plt.savefig("RNASeq_Volcano_Plot.png", dpi=300)
plt.show()

with open("RNASeq_Report.txt", "w", encoding="utf-8") as f:
    f.write("RNA-SEQ ANALYSIS REPORT\n\n")
    f.write(f"Genes analyzed: {len(results)}\n")
    f.write(f"Upregulated: {(results['Status'] == 'Upregulated').sum()}\n")
    f.write(f"Downregulated: {(results['Status'] == 'Downregulated').sum()}\n\n")
    f.write(results.to_string())

print("\nSaved Differential_Expression_Results.csv")
print("Saved RNASeq_Volcano_Plot.png and RNASeq_Report.txt")
