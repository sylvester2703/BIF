"""


# Assignment: RNA-Seq Data Analysis
# Differential Gene Expression Analysis
# No external dataset required

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from pydeseq2.dds import DeseqDataSet
from pydeseq2.ds import DeseqStats

# --------------------------------------------------
# 1. GENERATE SYNTHETIC RNA-SEQ DATA
# --------------------------------------------------

np.random.seed(42)

n_genes = 500
samples = ["C1", "C2", "C3", "T1", "T2", "T3"]
genes = [f"Gene_{i:03d}" for i in range(1, n_genes + 1)]

# Generate baseline expression levels
baseline = np.random.gamma(
    shape=3, scale=30, size=n_genes
)

# Rows = genes, columns = samples initially
raw_counts = np.zeros((n_genes, len(samples)), dtype=int)

# Control samples
for j in range(3):
    raw_counts[:, j] = np.random.poisson(baseline)

# Treatment samples
for j in range(3, 6):
    raw_counts[:, j] = np.random.poisson(baseline)

# Simulate upregulated genes
for j in range(3, 6):
    raw_counts[:30, j] = np.random.poisson(
        baseline[:30] * 3
    )

# Simulate downregulated genes
for j in range(3, 6):
    raw_counts[30:60, j] = np.random.poisson(
        baseline[30:60] / 3
    )

# Build gene-by-sample DataFrame
gene_counts = pd.DataFrame(
    raw_counts,
    index=genes,
    columns=samples
)

# IMPORTANT FIX:
# PyDESeq2 expects samples in rows and genes in columns.
count_df = gene_counts.T.copy()

# Sample metadata: one row per sample
metadata = pd.DataFrame(
    {
        "condition": [
            "Control", "Control", "Control",
            "Treatment", "Treatment", "Treatment"
        ]
    },
    index=samples
)

# Simulated annotation information
annotations = pd.DataFrame({
    "gene_id": genes,
    "gene_name": genes,
    "description": [
        "Simulated gene; biological function unknown"
        for _ in genes
    ]
})

print("Count matrix shape:", count_df.shape)
print("Metadata shape:", metadata.shape)
print("\nSample metadata:")
print(metadata)

# Validate sample alignment
assert count_df.index.equals(metadata.index)

# Save generated dataset
gene_counts.to_csv("Synthetic_RNASeq_Counts.csv")

# --------------------------------------------------
# 2. FILTER LOW-COUNT GENES
# --------------------------------------------------

# Columns now represent genes
count_df = count_df.loc[
    :, count_df.sum(axis=0) >= 10
]

if count_df.empty:
    raise ValueError("No genes remain after filtering.")

print("\nFiltered count matrix:", count_df.shape)

# --------------------------------------------------
# 3. DIFFERENTIAL EXPRESSION ANALYSIS
# --------------------------------------------------

dds = DeseqDataSet(
    counts=count_df,
    metadata=metadata,
    design="~condition",
    refit_cooks=True,
    n_cpus=1
)

dds.deseq2()

# Compare Treatment against Control
stat = DeseqStats(
    dds,
    contrast=("condition", "Treatment", "Control"),
    n_cpus=1
)

stat.summary()

results = stat.results_df.copy()
results.index.name = "gene_id"

# --------------------------------------------------
# 4. CLASSIFY DIFFERENTIALLY EXPRESSED GENES
# --------------------------------------------------

results["Status"] = "Not Significant"

valid = results["padj"].notna()

up = (
    valid
    & (results["padj"] < 0.05)
    & (results["log2FoldChange"] >= 1)
)

down = (
    valid
    & (results["padj"] < 0.05)
    & (results["log2FoldChange"] <= -1)
)

results.loc[up, "Status"] = "Upregulated"
results.loc[down, "Status"] = "Downregulated"

# --------------------------------------------------
# 5. ADD FUNCTIONAL ANNOTATION
# --------------------------------------------------

results = results.reset_index().merge(
    annotations,
    on="gene_id",
    how="left",
    validate="one_to_one"
)

results = results.sort_values(
    "padj", na_position="last"
)

upregulated = results[
    results["Status"] == "Upregulated"
]

downregulated = results[
    results["Status"] == "Downregulated"
]

significant = results[
    results["Status"].isin(
        ["Upregulated", "Downregulated"]
    )
]

print("\n--- ANALYSIS SUMMARY ---")
print("Genes analyzed:", len(results))
print("Upregulated genes:", len(upregulated))
print("Downregulated genes:", len(downregulated))
print("Significant genes:", len(significant))

print("\nTop differentially expressed genes:")
print(significant.head(10).to_string(index=False))

# --------------------------------------------------
# 6. GENERATE VOLCANO PLOT
# --------------------------------------------------

plot_df = results.dropna(
    subset=["log2FoldChange", "padj"]
).copy()

plot_df["MinusLog10Padj"] = -np.log10(
    plot_df["padj"].clip(lower=1e-300)
)

plt.figure(figsize=(9, 6))

for status in [
    "Not Significant",
    "Upregulated",
    "Downregulated"
]:
    subset = plot_df[plot_df["Status"] == status]

    plt.scatter(
        subset["log2FoldChange"],
        subset["MinusLog10Padj"],
        label=status,
        alpha=0.7,
        s=20
    )

plt.axvline(1, linestyle="--")
plt.axvline(-1, linestyle="--")
plt.axhline(-np.log10(0.05), linestyle="--")

plt.xlabel("Log2 Fold Change")
plt.ylabel("-Log10 Adjusted P-value")
plt.title("RNA-Seq Differential Gene Expression")
plt.legend()
plt.tight_layout()
plt.savefig("RNASeq_Volcano_Plot.png", dpi=300)
plt.show()

# --------------------------------------------------
# 7. SAVE RESULTS
# --------------------------------------------------

results.to_csv(
    "RNASeq_Differential_Expression.csv",
    index=False
)

upregulated.to_csv(
    "Upregulated_Genes.csv", index=False
)

downregulated.to_csv(
    "Downregulated_Genes.csv", index=False
)

# --------------------------------------------------
# 8. GENERATE DETAILED REPORT
# --------------------------------------------------

with open(
    "RNASeq_Analysis_Report.txt",
    "w",
    encoding="utf-8"
) as report:

    report.write("RNA-SEQ ANALYSIS REPORT\n")
    report.write("=" * 40 + "\n\n")

    report.write("Dataset: Synthetic RNA-Seq counts\n")
    report.write("Method: PyDESeq2\n")
    report.write("Comparison: Treatment versus Control\n")
    report.write("Adjusted p-value threshold: 0.05\n")
    report.write("Absolute log2 fold-change threshold: 1\n\n")

    report.write(f"Samples analyzed: {len(metadata)}\n")
    report.write(f"Genes analyzed: {len(results)}\n")
    report.write(f"Upregulated genes: {len(upregulated)}\n")
    report.write(f"Downregulated genes: {len(downregulated)}\n")
    report.write(f"Significant genes: {len(significant)}\n\n")

    report.write("TOP DIFFERENTIALLY EXPRESSED GENES\n")
    report.write("-" * 40 + "\n")

    if significant.empty:
        report.write(
            "No genes met both significance thresholds.\n"
        )
    else:
        report.write(
            significant.head(20).to_string(index=False)
        )
        report.write("\n")

    report.write("\nFUNCTIONAL ANNOTATION\n")
    report.write(
        "Gene descriptions are placeholders because the "
        "dataset is synthetic. Real biological annotations "
        "and pathway enrichment are not included.\n"
    )

    report.write("\nBIOLOGICAL INTERPRETATION\n")
    report.write(
        f"{len(upregulated)} genes were classified as "
        "upregulated and "
        f"{len(downregulated)} as downregulated in Treatment "
        "relative to Control.\n"
    )

    report.write(
        "These results demonstrate a computational workflow "
        "and do not establish genuine biological findings. "
        "Real RNA-Seq data and verified annotations are "
        "required for biological conclusions.\n"
    )

print("\nAnalysis completed successfully.")
print("\nGenerated files:")
print("1. Synthetic_RNASeq_Counts.csv")
print("2. RNASeq_Differential_Expression.csv")
print("3. Upregulated_Genes.csv")
print("4. Downregulated_Genes.csv")
print("5. RNASeq_Volcano_Plot.png")
print("6. RNASeq_Analysis_Report.txt")
