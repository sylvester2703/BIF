import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from pydeseq2.dds import DeseqDataSet
from pydeseq2.ds import DeseqStats
# 1. Configure the dataset and output folder
DATA_SOURCE = "builtin"  # Use "external" for your own dataset
DATASET_PATH = r"C:\Users\Dell\OneDrive\Desktop\GSE171258_RNAseq_coding_count.csv"
GENE_ID_COLUMN = "gene_id"
CONDITION_COLUMN = "condition"
REFERENCE_CONDITION = "Control"
OUTPUT_FOLDER = "RNASeq_Results"
# 2. Generate a demonstration dataset or load an external dataset
if DATA_SOURCE == "builtin":
    np.random.seed(42)
    genes = [f"Gene_{i:04d}" for i in range(1, 1001)]
    samples = [f"Sample_{i}" for i in range(1, 7)]
    conditions = ["Control"] * 3 + ["Treatment"] * 3
    base_means = np.random.lognormal(4, 1.2, 1000)
    values = np.zeros((1000, 6), dtype=int)
    # Simulate increased and decreased expression in treatment samples
    for i in range(1000):
        for j in range(6):
            mean = base_means[i]
            if conditions[j] == "Treatment" and i < 50:
                mean *= 3
            elif conditions[j] == "Treatment" and i < 100:
                mean *= 0.3
            values[i, j] = np.random.negative_binomial(
                10, 10 / (10 + mean)
            )
    counts = pd.DataFrame(values, index=genes, columns=samples)
    metadata = pd.DataFrame(
        {"condition": conditions}, index=samples
    )
    metadata.index.name = "sample"
else:
    # Load an external CSV or Excel file in long format
    if not os.path.isfile(DATASET_PATH):
        raise FileNotFoundError(f"Dataset not found: {DATASET_PATH}")
    if DATASET_PATH.lower().endswith((".xlsx", ".xls")):
        raw = pd.read_excel(DATASET_PATH)
    else:
        raw = pd.read_csv(DATASET_PATH)
    required = {GENE_ID_COLUMN, "sample", CONDITION_COLUMN, "count"}
    if not required.issubset(raw.columns):
        raise ValueError(
            f"Dataset must contain these columns: {required}"
        )
    if raw[list(required)].isna().any().any():
        raise ValueError("Required dataset columns contain missing values.")
    if raw.duplicated([GENE_ID_COLUMN, "sample"]).any():
        raise ValueError("Duplicate gene-sample rows found.")
    if raw.groupby("sample")[CONDITION_COLUMN].nunique().gt(1).any():
        raise ValueError("Each sample must have one condition.")
    counts = raw.pivot(
        index=GENE_ID_COLUMN, columns="sample", values="count"
    )
    metadata = (
        raw[["sample", CONDITION_COLUMN]]
        .drop_duplicates()
        .set_index("sample")
    )
    metadata.columns = ["condition"]
# 3. Validate the count matrix and sample information
if counts.empty or metadata.empty:
    raise ValueError("The dataset is empty.")
counts.index = counts.index.astype(str)
counts.columns = counts.columns.astype(str)
metadata.index = metadata.index.astype(str)
if not counts.index.is_unique or not counts.columns.is_unique:
    raise ValueError("Gene IDs and sample IDs must be unique.")
if set(counts.columns) != set(metadata.index):
    raise ValueError("Count matrix and metadata sample IDs do not match.")
metadata = metadata.loc[counts.columns]
counts = counts.apply(pd.to_numeric, errors="raise")
values = counts.to_numpy(dtype=float)
if not np.isfinite(values).all() or (values < 0).any():
    raise ValueError("Counts must be finite and nonnegative.")
if not np.allclose(values, np.round(values)):
    raise ValueError("Use raw integer read counts, not TPM or FPKM.")
counts = counts.astype(np.int64)
if metadata["condition"].nunique() != 2:
    raise ValueError("Exactly two conditions are required.")
if (metadata["condition"].value_counts() < 2).any():
    raise ValueError("Each condition needs at least two biological replicates.")
# 4. Remove genes with very low total counts
counts = counts.loc[counts.sum(axis=1) >= 10]
if counts.empty:
    raise ValueError("No genes remain after filtering.")
count_df = counts.T.copy()
metadata = metadata.loc[count_df.index]
# 5. Set the reference and treatment conditions
conditions = metadata["condition"].unique().tolist()
if REFERENCE_CONDITION not in conditions:
    raise ValueError("Reference condition not found in the dataset.")
treatment = next(
    condition for condition in conditions
    if condition != REFERENCE_CONDITION
)
metadata["condition"] = pd.Categorical(
    metadata["condition"],
    categories=[REFERENCE_CONDITION, treatment]
)
# 6. Perform differential gene expression analysis
dds = DeseqDataSet(
    counts=count_df,
    metadata=metadata,
    design="~condition",
    refit_cooks=True,
    n_cpus=1
)
dds.deseq2()
stats = DeseqStats(
    dds,
    contrast=("condition", treatment, REFERENCE_CONDITION),
    n_cpus=1
)
stats.summary()
results = stats.results_df.copy()
results.index.name = "gene_id"
results = results.reset_index()
# 7. Classify significantly upregulated and downregulated genes
results["Status"] = "Not Significant"
significant = (
    results["padj"].notna()
    & (results["padj"] < 0.05)
    & (results["log2FoldChange"].abs() >= 1)
)
results.loc[
    significant & (results["log2FoldChange"] > 0), "Status"
] = "Upregulated"
results.loc[
    significant & (results["log2FoldChange"] < 0), "Status"
] = "Downregulated"
results = results.sort_values("padj", na_position="last")
upregulated = results[results["Status"] == "Upregulated"]
downregulated = results[results["Status"] == "Downregulated"]
differential = results[
    results["Status"].isin(["Upregulated", "Downregulated"])
]
# 8. Display the analysis summary
print("\n--- RNA-SEQ ANALYSIS SUMMARY ---")
print("Reference condition:", REFERENCE_CONDITION)
print("Treatment condition:", treatment)
print("Samples analyzed:", len(metadata))
print("Genes analyzed:", len(results))
print("Upregulated genes:", len(upregulated))
print("Downregulated genes:", len(downregulated))
print("Significant genes:", len(differential))
print("\nTop differentially expressed genes:")
print(differential.head(10).to_string(index=False))
# 9. Save the result tables
os.makedirs(OUTPUT_FOLDER, exist_ok=True)
results.to_csv(
    os.path.join(OUTPUT_FOLDER, "RNASeq_Differential_Expression.csv"),
    index=False
)
upregulated.to_csv(
    os.path.join(OUTPUT_FOLDER, "Upregulated_Genes.csv"),
    index=False
)
downregulated.to_csv(
    os.path.join(OUTPUT_FOLDER, "Downregulated_Genes.csv"),
    index=False
)
# 10. Create and save the volcano plot
plot_df = results.dropna(
    subset=["log2FoldChange", "padj"]
).copy()
plot_df["neg_log10_padj"] = -np.log10(
    plot_df["padj"].clip(lower=1e-300)
)
plt.figure(figsize=(9, 6))
for status in ["Not Significant", "Upregulated", "Downregulated"]:
    subset = plot_df[plot_df["Status"] == status]
    plt.scatter(
        subset["log2FoldChange"],
        subset["neg_log10_padj"],
        label=status,
        alpha=0.7,
        s=20
    )
plt.axvline(1, linestyle="--")
plt.axvline(-1, linestyle="--")
plt.axhline(-np.log10(0.05), linestyle="--")
plt.xlabel("Log2 Fold Change")
plt.ylabel("-Log10 Adjusted P-value")
plt.title("RNA-Seq Differential Gene Expression")
plt.legend()
plt.tight_layout()
plt.savefig(
    os.path.join(OUTPUT_FOLDER, "RNASeq_Volcano_Plot.png"),
    dpi=300
)
plt.show()
plt.close()
# 11. Generate the analysis report
with open(
    os.path.join(OUTPUT_FOLDER, "RNASeq_Analysis_Report.txt"),
    "w",
    encoding="utf-8"
) as report:
    report.write("RNA-SEQ DIFFERENTIAL EXPRESSION REPORT\n")
    report.write("=" * 40 + "\n\n")
    report.write(f"Reference: {REFERENCE_CONDITION}\n")
    report.write(f"Treatment: {treatment}\n")
    report.write(f"Samples analyzed: {len(metadata)}\n")
    report.write(f"Genes analyzed: {len(results)}\n")
    report.write(f"Upregulated genes: {len(upregulated)}\n")
    report.write(f"Downregulated genes: {len(downregulated)}\n")
    report.write(f"Significant genes: {len(differential)}\n")
    report.write(
        "\nCriteria: adjusted p-value < 0.05 and "
        "absolute log2 fold change >= 1\n"
    )
    report.write("\nTOP DIFFERENTIALLY EXPRESSED GENES\n")
    report.write(
        differential.head(20).to_string(index=False)
        if not differential.empty
        else "No genes met both significance thresholds."
    )
    report.write(
        "\n\nPositive log2 fold change means higher expression in "
        f"{treatment} relative to {REFERENCE_CONDITION}.\n"
    )
    if DATA_SOURCE == "builtin":
        report.write(
            "\nThis report uses synthetic demonstration data, "
            "not real biological evidence.\n"
        )
