    )

    report.write(
        "\nFunctional interpretation requires verified gene "
        "annotations and, ideally, pathway enrichment analysis. "
        "Differential expression alone does not establish causation.\n"
    )

print("\nAnalysis completed successfully.")
print("\nGenerated files:")
print("1. RNASeq_Differential_Expression.csv")
print("2. Upregulated_Genes.csv")
