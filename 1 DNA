from Bio.Seq import Seq
from Bio.SeqUtils import gc_fraction
import matplotlib.pyplot as plt
from collections import Counter
# 1. Input and validate DNA sequence
dna = input("Enter DNA sequence (e.g., ATGCTAGCTAGCTCGATCGATCGATC): ").upper()
dna = "".join(dna.split())
if not dna:
    raise ValueError("DNA sequence cannot be empty.")
if any(base not in "ATGC" for base in dna):
    raise ValueError("Invalid DNA sequence. Use only A, T, G and C.")
seq = Seq(dna)
length = len(dna)
# 2. Basic sequence analysis
print("\n--- BASIC SEQUENCE ANALYSIS ---")
print("DNA Sequence:", dna)
print("Sequence Length:", length, "bp")
print("Complement:", seq.complement())
print("Reverse Complement:", seq.reverse_complement())
# 3. Nucleotide frequency
counts = Counter(dna)
print("\n--- NUCLEOTIDE FREQUENCY ---")
for base in "ATGC":
    print(f"{base}: {counts[base]}")
# 4. Calculate GC and AT content
gc_content = gc_fraction(seq) * 100
at_content = 100 - gc_content
print("\n--- GC CONTENT ---")
print(f"GC Content: {gc_content:.2f}%")
print(f"AT Content: {at_content:.2f}%")
# 5. Search for a DNA motif
while True:
    motif = input("\nEnter motif to search (e.g., ATG) or type 'exit' to skip: ").upper().strip()
    if motif == "EXIT":
        print("Motif search cancelled.")
        motif = ""
        motif_positions = []
        motif_searched = False
        break
    if not motif or any(base not in "ATGC" for base in motif):
        print("Invalid motif! Use only A, T, G and C. Try again.")
        continue
    motif_positions = [
        i + 1 for i in range(length)
        if dna.startswith(motif, i)
    ]
    motif_searched = True
    break
print("\n--- MOTIF ANALYSIS ---")
if motif_searched:
    print("Motif:", motif)
    print("Number of occurrences:", len(motif_positions))
    print("Positions (1-based):", motif_positions)
else:
    print("Motif search was skipped.")
# 6. Identify complete ORFs in all six reading frames
stop_codons = {"TAA", "TAG", "TGA"}
orfs = []
# Analyze three forward frames and three reverse frames
for strand_name, strand_seq in [
    ("Forward", str(seq)),
    ("Reverse", str(seq.reverse_complement()))
]:
    for frame in range(3):
        start_positions = []
        for i in range(frame, len(strand_seq) - 2, 3):
            codon = strand_seq[i:i + 3]
            if codon == "ATG":
                start_positions.append(i)
            if codon in stop_codons:
                for start in start_positions:
                    region = strand_seq[start:i + 3]
                    # Convert reverse-strand positions to original DNA coordinates
                    if strand_name == "Forward":
                        start_pos = start + 1
                        end_pos = i + 3
                    else:
                        start_pos = length - (i + 3) + 1
                        end_pos = length - start
                    orfs.append({
                        "strand": strand_name,
                        "start": start_pos,
                        "end": end_pos,
                        "length": len(region),
                        "frame": frame + 1,
                        "sequence": region
                    })
                start_positions = []
print("\n--- CODING REGION ANALYSIS ---")
print("Complete ORFs found:", len(orfs))
for index, orf in enumerate(orfs, start=1):
    print(f"\nORF {index}")
    print("Strand:", orf["strand"])
    print("Start:", orf["start"])
    print("End:", orf["end"])
    print("Length:", orf["length"], "bp")
    print("Reading frame:", orf["frame"])
    print("DNA:", orf["sequence"])
    print("Protein:", Seq(orf["sequence"]).translate(to_stop=True))
if not orfs:
    print("No complete ORFs found in the six reading frames.")
# 7. Visualize nucleotide composition
bases = list("ATGC")
frequencies = [counts[base] for base in bases]
plt.figure(figsize=(7, 4))
plt.bar(bases, frequencies)
plt.title("DNA Nucleotide Composition")
plt.xlabel("Nucleotide")
plt.ylabel("Count")
plt.tight_layout()
plt.show()
# 8. Generate the DNA analysis report
with open("DNA_Analysis_Report.txt", "w", encoding="utf-8") as report:
    report.write("DNA SEQUENCE ANALYSIS REPORT\n")
    report.write("=" * 35 + "\n\n")
    report.write(f"DNA Sequence: {dna}\n")
    report.write(f"Sequence Length: {length} bp\n")
    report.write(f"Complement: {seq.complement()}\n")
    report.write(f"Reverse Complement: {seq.reverse_complement()}\n\n")
    report.write("NUCLEOTIDE COMPOSITION\n")
    for base in bases:
        report.write(f"{base}: {counts[base]}\n")
    report.write(f"\nGC Content: {gc_content:.2f}%\n")
    report.write(f"AT Content: {at_content:.2f}%\n")
    report.write("\nMOTIF ANALYSIS\n")
    if motif_searched:
        report.write(f"Motif: {motif}\n")
        report.write(f"Occurrences: {len(motif_positions)}\n")
        report.write(f"Positions (1-based): {motif_positions}\n")
    else:
        report.write("Motif search was skipped by the user.\n")
    report.write("\nCODING REGION ANALYSIS\n")
    report.write(f"Complete ORFs found: {len(orfs)}\n")
    for index, orf in enumerate(orfs, start=1):
        report.write(f"\nORF {index}\n")
        report.write(f"Strand: {orf['strand']}\n")
        report.write(
            f"Start: {orf['start']}, End: {orf['end']}, "
            f"Length: {orf['length']} bp, "
            f"Frame: {orf['frame']}\n"
        )
        report.write(f"DNA: {orf['sequence']}\n")
        report.write(
            f"Protein: {Seq(orf['sequence']).translate(to_stop=True)}\n"
        )
    report.write("\nINSIGHTS\n")
    report.write(
        f"The sequence contains {length} nucleotides, "
        f"with GC content of {gc_content:.2f}%.\n"
    )
    if motif_searched:
        report.write(
            f"The motif '{motif}' occurs {len(motif_positions)} time(s).\n"
        )
    else:
        report.write("Motif searching was skipped.\n")
    report.write(
        f"{len(orfs)} complete ORFs were identified "
        "across the six reading frames.\n"
    )
    report.write(
        "ORFs are potential coding regions and require further "
        "biological validation before being considered genes.\n"
    )
# 9. Display completion messages
print("\nAnalysis complete.")
print("Visualization generated.")
print("Report saved as DNA_Analysis_Report.txt")
